{
  "name": "pricing-feed-api",
  "version": "1.0.0",
  "private": true,
  "description": "Pricing Feed API - upload, ingest, search and edit retail store price records",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "generate:feeds": "tsx scripts/generate-feeds.ts"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/cors": "^11.4.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.7",
    "@fastify/rate-limit": "^11.2.2",
    "csv-parse": "^7.0.3",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
